# ============================================================
# SECRETS - never let these into an image layer.
# Layers are immutable: deleting a file later does NOT remove it,
# and this image is pushed to a public registry.
# NOTE: a pattern of "env/" does NOT match the file ".env".
# ============================================================
.env
.env.*
!.env.example
*.pem
*.key

# Build metadata
.dockerignore

# Version control
.git
.gitignore
.github

# Environments
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Runtime state - regenerated by the app, must not be baked in
chatbot.db
chatbot.db-shm
chatbot.db-wal
*.db
*.db-shm
*.db-wal
faiss_db/

# Python cruft
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editor settings
.vscode/
.idea/
*.code-workspace

# Local scratch
*.bak*
diagnose_rag.py
docs/
README.md
LICENSE
