# Copy this file to `.env` and fill in your own keys.
# `.env` is git-ignored and must never be committed.

# --- Required ---
OPENAI_API_KEY=sk-...            # chat model + embeddings
TAVILY_API_KEY=tvly-...          # web search tool

# --- Required for the corresponding tools ---
ALPHA_VANTAGE_API_KEY=...        # get_stock_price
OPENWEATHER_API_KEY=...          # get_current_weather

# --- Optional: LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agentic-chatbot
